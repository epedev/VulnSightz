<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ metadata.report_title }} — VulnSight</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #e8eef0;
      --bg-deep: #dfe8ea;
      --ink: #0c1b22;
      --muted: #5a7179;
      --line: rgba(12, 40, 48, 0.12);
      --brand: #0d4a57;
      --brand-soft: #135a69;
      --accent: #1a9e8f;
      --accent-soft: rgba(26, 158, 143, 0.12);
      --amber: #c98512;
      --card: #ffffff;
      --shadow: 0 10px 30px rgba(12, 27, 34, 0.06);
      --radius: 14px;
      --crit: #9f1239;
      --high: #c2410c;
      --med: #b45309;
      --low: #1d4ed8;
      --info: #475569;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: "DM Sans", "Segoe UI", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(900px 420px at 8% -10%, rgba(26,158,143,0.16), transparent 55%),
        radial-gradient(700px 340px at 100% 0%, rgba(201,133,18,0.10), transparent 50%),
        linear-gradient(180deg, var(--bg) 0%, var(--bg-deep) 100%);
      line-height: 1.55;
      min-height: 100vh;
    }
    a { color: var(--brand); text-underline-offset: 2px; }
    a:hover { color: var(--accent); }
    .wrap { max-width: 1180px; margin: 0 auto; padding: 1rem 1.15rem 4.5rem; }

    .topnav {
      position: sticky; top: 0; z-index: 40;
      display: flex; flex-wrap: wrap; gap: 0.75rem 1.1rem; align-items: center;
      justify-content: space-between;
      backdrop-filter: blur(14px) saturate(1.2);
      background: rgba(232, 238, 240, 0.82);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.55rem 0.9rem;
      margin: 0.35rem 0 1.15rem;
      box-shadow: var(--shadow);
    }
    .brand {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-weight: 600; letter-spacing: 0.1em; font-size: 0.78rem; color: var(--brand);
    }
    .nav-links { display: flex; flex-wrap: wrap; gap: 0.15rem; }
    .nav-links a {
      text-decoration: none; font-size: 0.84rem; color: var(--muted);
      padding: 0.35rem 0.65rem; border-radius: 999px; font-weight: 500;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .nav-links a:hover, .nav-links a:focus-visible {
      background: var(--accent-soft); color: var(--brand); outline: none;
    }

    header.cover {
      background:
        linear-gradient(145deg, rgba(13,74,87,0.96), rgba(11,47,56,0.98)),
        radial-gradient(500px 220px at 90% 20%, rgba(26,158,143,0.35), transparent 60%);
      color: #f3fbfa;
      padding: clamp(1.5rem, 3.5vw, 2.35rem);
      margin-bottom: 1.1rem;
      border-radius: calc(var(--radius) + 4px);
      position: relative; overflow: hidden;
      box-shadow: 0 18px 40px rgba(11, 47, 56, 0.22);
      animation: rise 0.45s ease both;
    }
    header.cover::after {
      content: ""; position: absolute; inset: auto -50px -80px auto;
      width: 260px; height: 260px; border-radius: 50%;
      background: radial-gradient(circle, rgba(201,133,18,0.28), transparent 68%);
      pointer-events: none;
    }
    header.cover .product {
      font-family: "IBM Plex Mono", monospace; font-size: 0.72rem;
      letter-spacing: 0.14em; text-transform: uppercase; color: #f0c36a;
      margin-bottom: 0.55rem;
    }
    header.cover h1 {
      margin: 0 0 1rem;
      font-family: "Source Serif 4", Georgia, serif;
      font-size: clamp(1.55rem, 3.4vw, 2.15rem);
      letter-spacing: -0.02em; font-weight: 700; max-width: 18ch;
    }
    .meta {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(168px, 1fr));
      gap: 0.55rem; position: relative; z-index: 1;
    }
    .meta div {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.08);
      padding: 0.65rem 0.8rem; border-radius: 10px;
    }
    .meta dt {
      font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em;
      opacity: 0.72; font-family: "IBM Plex Mono", monospace;
    }
    .meta dd { margin: 0.2rem 0 0; font-weight: 650; word-break: break-word; font-size: 0.92rem; }

    section.panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.25rem 1.35rem 1.4rem;
      margin-bottom: 1rem;
      box-shadow: var(--shadow);
      animation: rise 0.5s ease both;
    }
    section.panel:nth-of-type(2) { animation-delay: 0.04s; }
    section.panel:nth-of-type(3) { animation-delay: 0.08s; }
    h2 {
      margin: 0 0 0.85rem; color: var(--brand);
      font-family: "Source Serif 4", Georgia, serif;
      font-size: 1.35rem; letter-spacing: -0.015em; font-weight: 700;
    }
    h3 { margin: 1.1rem 0 0.4rem; font-size: 0.98rem; color: var(--brand-soft); }
    .lead { color: var(--muted); margin: 0 0 1rem; font-size: 0.95rem; }

    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); gap: 0.65rem; }
    .card {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 0.9rem 0.85rem;
      background: linear-gradient(180deg, #fff 0%, #f7fafb 100%);
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .card:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: rgba(26,158,143,0.35); }
    .card .num {
      font-size: 1.65rem; font-weight: 750; color: var(--brand);
      font-variant-numeric: tabular-nums; letter-spacing: -0.03em; line-height: 1.1;
    }
    .card .lbl { color: var(--muted); font-size: 0.8rem; margin-top: 0.25rem; font-weight: 500; }

    .split { display: grid; grid-template-columns: 1.15fr 1fr; gap: 1.1rem; }
    @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }

    .bars { display: grid; gap: 0.55rem; margin-top: 0.35rem; }
    .bar-row { display: grid; grid-template-columns: 88px 1fr 36px; gap: 0.55rem; align-items: center; font-size: 0.86rem; }
    .bar-row .name { color: var(--muted); text-transform: capitalize; font-weight: 550; }
    .bar-track { height: 8px; background: #e7eef0; border-radius: 999px; overflow: hidden; }
    .bar-fill {
      height: 100%; border-radius: inherit; width: 0;
      transition: width 0.7s cubic-bezier(.2,.8,.2,1);
    }
    .bar-row .count { text-align: right; font-variant-numeric: tabular-nums; font-weight: 650; }
    .fill-critical { background: var(--crit); }
    .fill-high { background: var(--high); }
    .fill-medium { background: var(--med); }
    .fill-low { background: var(--low); }
    .fill-info, .fill-none { background: var(--info); }
    .fill-module { background: linear-gradient(90deg, var(--brand), var(--accent)); }

    .pill-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.4rem 0 0; padding: 0; list-style: none; }
    .pill-list li {
      background: #f3f7f8; border: 1px solid var(--line); border-radius: 999px;
      padding: 0.28rem 0.7rem; font-size: 0.82rem; color: var(--ink);
    }
    .pill-list li strong { color: var(--brand); font-weight: 700; }

    .toolbar {
      display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center;
      margin: 0.35rem 0 0.85rem; position: sticky; top: 3.4rem; z-index: 30;
      background: rgba(255,255,255,0.92); backdrop-filter: blur(10px);
      border: 1px solid var(--line); border-radius: 12px; padding: 0.55rem;
    }
    .chip {
      border: 1px solid var(--line); background: #fff; color: var(--ink);
      padding: 0.38rem 0.75rem; font-size: 0.8rem; cursor: pointer;
      border-radius: 999px; font-weight: 600; font: inherit;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.12s ease;
    }
    .chip:hover { transform: translateY(-1px); border-color: rgba(26,158,143,0.45); }
    .chip[aria-pressed="true"] { background: var(--brand); color: #fff; border-color: var(--brand); }
    .chip.sev-critical[aria-pressed="true"] { background: var(--crit); border-color: var(--crit); }
    .chip.sev-high[aria-pressed="true"] { background: var(--high); border-color: var(--high); }
    .chip.sev-medium[aria-pressed="true"] { background: var(--med); border-color: var(--med); }
    .chip.sev-low[aria-pressed="true"] { background: var(--low); border-color: var(--low); }
    .search {
      flex: 1 1 200px; min-width: 160px;
      border: 1px solid var(--line); padding: 0.48rem 0.75rem; font: inherit;
      border-radius: 999px; background: #f8fbfb;
    }
    .search:focus { outline: 2px solid rgba(26,158,143,0.35); border-color: var(--accent); }

    .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    th, td { border-bottom: 1px solid var(--line); padding: 0.65rem 0.55rem; text-align: left; vertical-align: top; }
    th {
      color: var(--muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em;
      background: #f4f8f9; position: sticky; top: 0;
    }
    tbody tr:last-child td { border-bottom: 0; }
    tr.finding-row { cursor: pointer; transition: background 0.12s ease; }
    tr.finding-row:hover { background: var(--accent-soft); }
    tr.finding-row:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    tr.finding-row[hidden] { display: none; }
    td .mono { font-family: "IBM Plex Mono", monospace; font-size: 0.8rem; }

    .badge {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 4.4rem; text-align: center;
      padding: 0.18rem 0.55rem; font-size: 0.7rem; font-weight: 750; color: #fff;
      text-transform: uppercase; letter-spacing: 0.04em; border-radius: 999px;
    }
    .sev-critical { background: var(--crit); }
    .sev-high { background: var(--high); }
    .sev-medium { background: var(--med); }
    .sev-low { background: var(--low); }
    .sev-info, .sev-none { background: var(--info); }

    .status-dot {
      display: inline-block; width: 0.55rem; height: 0.55rem; border-radius: 50%;
      margin-right: 0.35rem; vertical-align: middle; background: var(--muted);
    }
    .status-dot.has-findings { background: var(--high); }
    .status-dot.clear { background: var(--accent); }
    .status-dot.limited { background: var(--amber); }

    .finding {
      border: 1px solid var(--line); border-radius: 12px; padding: 0;
      margin-top: 0.85rem; background: #fff; scroll-margin-top: 5.5rem;
      overflow: hidden; transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .finding[hidden] { display: none; }
    .finding.is-active { border-color: rgba(26,158,143,0.55); box-shadow: 0 0 0 3px var(--accent-soft); }
    .finding-head {
      display: flex; flex-wrap: wrap; gap: 0.65rem 1rem; align-items: flex-start;
      justify-content: space-between; padding: 1rem 1.1rem;
      cursor: pointer; background: linear-gradient(180deg, #fff, #f8fbfb);
    }
    .finding-head h3 {
      margin: 0 0 0.35rem; font-size: 1.05rem; color: var(--ink);
      font-family: "Source Serif 4", Georgia, serif;
    }
    .finding-meta { color: var(--muted); font-size: 0.86rem; display: flex; flex-wrap: wrap; gap: 0.35rem 0.75rem; }
    .finding-toggle {
      border: 1px solid var(--line); background: #fff; border-radius: 999px;
      padding: 0.35rem 0.75rem; font: inherit; font-size: 0.8rem; font-weight: 650;
      color: var(--brand); cursor: pointer;
    }
    .finding-body {
      display: none; padding: 0 1.1rem 1.1rem; border-top: 1px solid var(--line);
      animation: fade 0.2s ease;
    }
    .finding[open] .finding-body, .finding.is-open .finding-body { display: block; }
    .finding-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.75rem; margin: 0.9rem 0;
    }
    .kv {
      background: #f6fafb; border: 1px solid var(--line); border-radius: 10px; padding: 0.7rem 0.8rem;
    }
    .kv .k { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); font-family: "IBM Plex Mono", monospace; }
    .kv .v { margin-top: 0.2rem; font-weight: 600; word-break: break-word; }
    .copy-btn {
      border: 0; background: transparent; color: var(--accent); cursor: pointer;
      font: inherit; font-size: 0.78rem; font-weight: 650; padding: 0; margin-left: 0.35rem;
    }
    .muted { color: var(--muted); }
    pre, code { font-family: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace; font-size: 0.82rem; }
    pre {
      background: #0b1c22; color: #d7ebe7; padding: 0.9rem;
      overflow-x: auto; white-space: pre-wrap; word-break: break-word;
      border-radius: 10px; margin: 0.35rem 0 0;
    }
    ul.compact { margin: 0.4rem 0; padding-left: 1.15rem; }
    .notice {
      background: rgba(201,133,18,0.12); border-left: 4px solid var(--amber);
      color: #5c4300; padding: 0.8rem 0.95rem; margin-bottom: 1rem; border-radius: 0 10px 10px 0;
    }

    .downloads {
      display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;
      margin: 0 0 1rem; padding: 0.7rem 0.85rem;
      background: rgba(255,255,255,0.9); border: 1px solid var(--line);
      border-radius: 12px; box-shadow: var(--shadow);
    }
    .downloads .label { color: var(--muted); font-size: 0.84rem; margin-right: 0.15rem; font-weight: 600; }
    .dl-btn {
      display: inline-flex; align-items: center; gap: 0.3rem;
      border: 1px solid var(--line); background: #fff; color: var(--brand);
      padding: 0.42rem 0.8rem; font-size: 0.84rem; font-weight: 650;
      text-decoration: none; cursor: pointer; border-radius: 999px; font: inherit;
      transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    }
    .dl-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
    .dl-btn:disabled { opacity: 0.45; cursor: not-allowed; }
    #dl-status { margin-left: 0.25rem; font-size: 0.8rem; }

    .back-top {
      position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 50;
      border: 1px solid var(--line); background: #fff; color: var(--brand);
      border-radius: 999px; padding: 0.55rem 0.85rem; font: inherit; font-weight: 700;
      font-size: 0.8rem; cursor: pointer; box-shadow: var(--shadow);
      opacity: 0; pointer-events: none; transition: opacity 0.2s ease, transform 0.2s ease;
      transform: translateY(8px);
    }
    .back-top.show { opacity: 1; pointer-events: auto; transform: translateY(0); }

    footer.site-foot {
      color: var(--muted); font-size: 0.85rem; margin-top: 0.5rem;
      padding: 0.5rem 0.25rem;
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }
    @keyframes fade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @media print {
      .topnav, .toolbar, .downloads, .back-top, .finding-toggle { display: none !important; }
      body { background: #fff; }
      .finding-body { display: block !important; }
      section.panel, .finding { break-inside: avoid; box-shadow: none; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topnav">
      <div class="brand">VULNSIGHT REPORT</div>
      <nav class="nav-links" aria-label="Report sections">
        <a href="#executive-summary">Summary</a>
        <a href="#owasp-top10">OWASP</a>
        <a href="#findings-overview">Overview</a>
        <a href="#detailed-findings">Details</a>
        <a href="#assessment-quality">Quality</a>
      </nav>
    </div>

    <header class="cover">
      <div class="product">VulnSight · see the weakness · prove the risk</div>
      <h1>{{ metadata.report_title }}</h1>
      <div class="meta">
        <div><dt>Target</dt><dd>{{ metadata.target }}</dd></div>
        <div><dt>Authorized origin</dt><dd>{{ metadata.authorized_origin }}</dd></div>
        <div><dt>Assessment date</dt><dd>{{ metadata.assessment_date }}</dd></div>
        <div><dt>Generated (UTC)</dt><dd>{{ metadata.generated_at }}</dd></div>
        <div><dt>Scan ID</dt><dd>{{ metadata.scan_id }}</dd></div>
        <div><dt>Scanner version</dt><dd>{{ metadata.scanner_version }}</dd></div>
      </div>
    </header>

    <div class="downloads" role="region" aria-label="Download report">
      <span class="label">Export</span>
      <button class="dl-btn" type="button" id="dl-pdf"
        data-href="{{ artifact_links.get('pdf', 'vulnsight_report.pdf') }}"
        {% if not artifact_links.get('pdf_available', True) %}disabled title="PDF was not generated for this run"{% endif %}>PDF</button>
      <button class="dl-btn" type="button" id="dl-md-file"
        data-href="{{ artifact_links.get('md', 'vulnsight_report.md') }}">Markdown</button>
      <button class="dl-btn" type="button" id="dl-md-inline">Markdown (page)</button>
      <button class="dl-btn" type="button" id="dl-json"
        data-href="{{ artifact_links.get('json', 'normalized_findings.json') }}">JSON</button>
      <a class="dl-btn" href="#findings-overview">Jump to table</a>
      <span class="muted" id="dl-status" aria-live="polite"></span>
    </div>
    <script type="application/json" id="md-source">{{ markdown_source|tojson }}</script>

    {% if incomplete %}
    <div class="notice" role="status">
      <strong>Incomplete assessment:</strong> one or more inputs failed validation or listed modules were not executed.
      Do not treat this report as a complete security assessment.
    </div>
    {% endif %}

    <section class="panel" id="executive-summary">
      <h2>Executive summary</h2>
      <p class="lead">High-level outcome of the authorized assessment. Use filters below to inspect each finding.</p>
      <div class="cards">
        <div class="card"><div class="num">{{ summary.total_unique_findings }}</div><div class="lbl">Unique findings</div></div>
        <div class="card"><div class="num">{{ summary.highest_cvss_score if summary.highest_cvss_score is not none else '—' }}</div><div class="lbl">Highest CVSS</div></div>
        <div class="card"><div class="num">{{ summary.by_verification_status.get('confirmed', 0) }}</div><div class="lbl">Confirmed</div></div>
        <div class="card"><div class="num">{{ summary.by_verification_status.get('probable', 0) }}</div><div class="lbl">Probable</div></div>
        <div class="card"><div class="num">{{ summary.by_verification_status.get('candidate', 0) }}</div><div class="lbl">Candidates</div></div>
        <div class="card"><div class="num">{{ summary.unscored_findings }}</div><div class="lbl">Unscored</div></div>
      </div>

      {% set sev_total = summary.total_unique_findings or 0 %}
      {% set mod_total = summary.total_unique_findings or 0 %}
      <div class="split" style="margin-top:1.15rem;">
        <div>
          <h3>Severity distribution</h3>
          <div class="bars" id="severity-bars">
            {% for sev, count in summary.by_severity.items() %}
            <div class="bar-row">
              <span class="name">{{ sev }}</span>
              <div class="bar-track"><div class="bar-fill fill-{{ sev }}" data-pct="{{ ((count / sev_total * 100) if sev_total else 0)|round(1) }}"></div></div>
              <span class="count">{{ count }}</span>
            </div>
            {% else %}
            <p class="muted">No findings.</p>
            {% endfor %}
          </div>
        </div>
        <div>
          <h3>By source module</h3>
          <div class="bars">
            {% for mod, count in summary.by_source_module.items() %}
            <div class="bar-row">
              <span class="name">{{ mod }}</span>
              <div class="bar-track"><div class="bar-fill fill-module" data-pct="{{ ((count / mod_total * 100) if mod_total else 0)|round(1) }}"></div></div>
              <span class="count">{{ count }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <h3>Major observations</h3>
      <ul class="compact">
        {% for obs in summary.major_observations %}
        <li>{{ obs }}</li>
        {% else %}
        <li class="muted">No major observations.</li>
        {% endfor %}
      </ul>
      {% if summary.total_unique_findings == 0 %}
      <div class="notice" role="status">
        <strong>No findings reported</strong> for the modules that ran.
        This is not a certification of security and does not mean the target is safe.
      </div>
      {% endif %}
      <p class="muted" style="margin-top:0.9rem;">Scope: {{ metadata.scope }} · {{ metadata.purpose }}</p>
    </section>

    {% if summary.owasp_top10 %}
    <section class="panel" id="owasp-top10">
      <h2>OWASP Top 10:2025 coverage</h2>
      <p class="lead">
        {{ summary.owasp_top10.standard }}
        {% if summary.owasp_top10.edition_window %}
        · {{ summary.owasp_top10.edition_window }} cycle
        {% endif %}
        · Categories with findings:
        <strong>{{ summary.owasp_top10.categories_with_findings }}</strong>
        / {{ summary.owasp_top10.categories_tracked }}
      </p>
      <p class="muted">{{ summary.owasp_top10.note }}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Category</th>
              <th>Findings</th>
              <th>Status</th>
              <th>VulnSight coverage</th>
            </tr>
          </thead>
          <tbody>
            {% for row in summary.owasp_top10.categories %}
            <tr>
              <td><code>{{ row.id }}</code></td>
              <td>{{ row.name }}</td>
              <td>{{ row.findings }}</td>
              <td>
                <span class="status-dot {% if row.findings > 0 %}has-findings{% elif 'limited' in row.status %}limited{% else %}clear{% endif %}"></span>
                {{ row.status.replace('_', ' ') }}
              </td>
              <td class="muted">{{ row.vulnsight_coverage }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if summary.owasp_top10.legacy_2021 %}
      <h3>Legacy OWASP Top 10:2021 continuity</h3>
      <p class="muted">{{ summary.owasp_top10.legacy_2021.note }}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Category</th>
              <th>Findings</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {% for row in summary.owasp_top10.legacy_2021.categories %}
            <tr>
              <td><code>{{ row.id }}</code></td>
              <td>{{ row.name }}</td>
              <td>{{ row.findings }}</td>
              <td>{{ row.status.replace('_', ' ') }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </section>
    {% endif %}

    <section class="panel" id="findings-overview">
      <h2>Findings overview</h2>
      <div class="toolbar" role="toolbar" aria-label="Filter findings">
        <button type="button" class="chip" data-filter="all" aria-pressed="true">All</button>
        <button type="button" class="chip sev-critical" data-filter="critical" aria-pressed="false">Critical</button>
        <button type="button" class="chip sev-high" data-filter="high" aria-pressed="false">High</button>
        <button type="button" class="chip sev-medium" data-filter="medium" aria-pressed="false">Medium</button>
        <button type="button" class="chip sev-low" data-filter="low" aria-pressed="false">Low</button>
        <button type="button" class="chip sev-info" data-filter="info" aria-pressed="false">Info</button>
        <input class="search" id="find-search" type="search" placeholder="Search title, URL, CWE, OWASP, module…" aria-label="Search findings">
      </div>
      <p class="muted" id="filter-count"></p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Title</th>
              <th>Severity</th>
              <th>CVSS</th>
              <th>Verification</th>
              <th>URL</th>
              <th>Param</th>
              <th>CWE</th>
              <th>OWASP</th>
              <th>Module</th>
            </tr>
          </thead>
          <tbody>
            {% for f in findings %}
            <tr class="finding-row" tabindex="0" data-severity="{{ f.severity }}" data-search="{{ (f.title ~ ' ' ~ f.url ~ ' ' ~ (f.cwe or '') ~ ' ' ~ (f.owasp or '') ~ ' ' ~ f.source_module)|lower }}" data-target="finding-{{ f.id }}">
              <td><a class="mono" href="#finding-{{ f.id }}">{{ f.id[:8] }}</a></td>
              <td>{{ f.title }}</td>
              <td><span class="badge sev-{{ f.severity }}">{{ f.severity }}</span></td>
              <td>{% if f.cvss_base_score is not none %}{{ '%.1f'|format(f.cvss_base_score) }}{% else %}—{% endif %}</td>
              <td>{{ f.verification_status }}</td>
              <td class="mono">{{ f.url }}</td>
              <td>{{ f.parameter or '—' }}</td>
              <td>{{ f.cwe or '—' }}</td>
              <td>{{ f.owasp or '—' }}</td>
              <td>{{ f.source_module }}</td>
            </tr>
            {% else %}
            <tr><td colspan="10" class="muted">No findings to display.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel" id="detailed-findings">
      <h2>Detailed findings</h2>
      <p class="lead">Expand a finding for description, impact, remediation, and evidence. Click a row in the overview to jump here.</p>
      <p class="muted" style="margin-top:-0.4rem;">
        <button type="button" class="chip" id="expand-all" aria-pressed="false">Expand all</button>
        <button type="button" class="chip" id="collapse-all" aria-pressed="false">Collapse all</button>
      </p>
      {% for f in findings %}
      <article class="finding" id="finding-{{ f.id }}" data-severity="{{ f.severity }}" data-search="{{ (f.title ~ ' ' ~ f.url ~ ' ' ~ (f.cwe or '') ~ ' ' ~ (f.owasp or '') ~ ' ' ~ f.source_module)|lower }}">
        <div class="finding-head" data-accordion-trigger role="button" tabindex="0" aria-expanded="false" aria-controls="body-{{ f.id }}">
          <div>
            <h3>{{ f.title }}</h3>
            <div class="finding-meta">
              <span class="badge sev-{{ f.severity }}">{{ f.severity }}</span>
              <span>
                {% if f.cvss_base_score is not none %}
                CVSS {{ f.cvss_version }} {{ '%.1f'|format(f.cvss_base_score) }}
                {% else %}
                CVSS unscored
                {% endif %}
              </span>
              <span>{{ f.verification_status }}</span>
              <span>confidence {{ f.confidence }}</span>
              <span>{{ f.source_module }}</span>
            </div>
          </div>
          <button type="button" class="finding-toggle" aria-hidden="true">Show details</button>
        </div>
        <div class="finding-body" id="body-{{ f.id }}">
          <div class="finding-grid">
            <div class="kv"><div class="k">Endpoint</div><div class="v">{{ f.method }} {{ f.url }}</div></div>
            <div class="kv"><div class="k">Parameter</div><div class="v">{{ f.parameter or '—' }}{% if f.location %} · {{ f.location }}{% endif %}</div></div>
            <div class="kv"><div class="k">Classification</div><div class="v">{{ f.cwe or 'n/a' }} · {{ f.owasp or 'n/a' }}</div></div>
            <div class="kv">
              <div class="k">CVSS vector</div>
              <div class="v">
                {% if f.cvss_vector %}
                <code id="cvss-{{ f.id }}">{{ f.cvss_vector }}</code>
                <button type="button" class="copy-btn" data-copy="cvss-{{ f.id }}">Copy</button>
                <div class="muted" style="font-weight:500;margin-top:0.2rem;">{{ f.cvss_provenance }}</div>
                {% else %}
                — ({{ f.cvss_status }})
                {% endif %}
              </div>
            </div>
          </div>
          <p><strong>Description</strong><br>{{ f.description }}</p>
          <p><strong>Impact</strong><br>{{ f.impact }}</p>
          <p><strong>Remediation</strong><br>{{ f.remediation }}</p>
          <p><strong>Source</strong><br>
            module={{ f.source_module }}
            · files={{ f.source_files|join(', ') }}
            · source_ids={{ f.source_ids|join(', ') or 'n/a' }}
            · priority {{ f.operational_priority or 'n/a' }}
          </p>
          <p><strong>Evidence</strong> <span class="muted">(escaped text; not executed)</span></p>
          <pre>{{ f.evidence | tojson(indent=2) }}</pre>
          {% if f.references %}
          <p><strong>References</strong></p>
          <ul class="compact">
            {% for ref in f.references %}<li><a href="{{ ref }}" rel="noopener noreferrer">{{ ref }}</a></li>{% endfor %}
          </ul>
          {% endif %}
        </div>
      </article>
      {% else %}
      <p class="muted">No detailed findings.</p>
      {% endfor %}
    </section>

    <section class="panel" id="assessment-quality">
      <h2>Assessment quality</h2>
      <p class="lead">Coverage honesty for academic review — not a score of target security.</p>
      <div class="cards">
        <div class="card"><div class="num">{{ modules_executed|length }}</div><div class="lbl">Modules executed</div></div>
        <div class="card"><div class="num">{{ modules_not_executed|length }}</div><div class="lbl">Modules not executed</div></div>
        <div class="card"><div class="num">{{ summary.by_verification_status.get('confirmed', 0) }}</div><div class="lbl">Confirmed</div></div>
        <div class="card"><div class="num">{{ summary.by_verification_status.get('probable', 0) + summary.by_verification_status.get('candidate', 0) }}</div><div class="lbl">Needs review</div></div>
      </div>
      <h3>False-positive / false-negative guidance</h3>
      <ul class="compact">
        <li>Treat <strong>candidate</strong> and <strong>probable</strong> findings as hypotheses requiring validation.</li>
        <li>CSRF form checks may false-positive when custom header-based CSRF defenses are used.</li>
        <li>Missing security headers on the home page do not prove every route lacks them.</li>
        <li>Zero findings is not a certification of security; coverage depends on crawl reach and module success.</li>
      </ul>
      <p class="muted">See repository document <code>docs/THREAT_MODEL.md</code> for assets, actors, and residual risk.</p>
    </section>

    <footer class="site-foot">
      Generated by VulnSight · schema {{ metadata.schema_version }} · timestamps in UTC · treat all evidence as untrusted data.
      Modules executed: {{ modules_executed|join(', ') or 'none' }}.
    </footer>
  </div>

  <button type="button" class="back-top" id="back-top" aria-label="Back to top">Top</button>

  <script>
    (function () {
      const chips = [...document.querySelectorAll('.chip[data-filter]')];
      const search = document.getElementById('find-search');
      const rows = [...document.querySelectorAll('tr.finding-row')];
      const details = [...document.querySelectorAll('article.finding')];
      const countEl = document.getElementById('filter-count');
      const statusEl = document.getElementById('dl-status');
      const backTop = document.getElementById('back-top');
      let severity = 'all';
      const total = rows.length;

      function setStatus(msg) {
        if (statusEl) statusEl.textContent = msg || '';
      }

      function haystack(el) {
        return (
          (el.getAttribute('data-search') || el.dataset.search || '') +
          ' ' +
          (el.textContent || '')
        ).toLowerCase();
      }

      function apply() {
        const q = ((search && search.value) || '').trim().toLowerCase();
        let visible = 0;
        rows.forEach((row) => {
          const sev = (row.getAttribute('data-severity') || row.dataset.severity || '').toLowerCase();
          const sevOk = severity === 'all' || sev === severity;
          const textOk = !q || haystack(row).includes(q);
          const show = sevOk && textOk;
          row.hidden = !show;
          if (show) visible += 1;
        });
        details.forEach((el) => {
          const sev = (el.getAttribute('data-severity') || el.dataset.severity || '').toLowerCase();
          const sevOk = severity === 'all' || sev === severity;
          const textOk = !q || haystack(el).includes(q);
          el.hidden = !(sevOk && textOk);
        });
        if (countEl) {
          countEl.textContent = total
            ? visible + ' of ' + total + ' finding(s) visible'
            : '0 findings in this report';
        }
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          severity = (chip.dataset.filter || 'all').toLowerCase();
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
          apply();
        });
      });
      if (search) search.addEventListener('input', apply);

      function openFinding(article, open) {
        if (!article) return;
        article.classList.toggle('is-open', open);
        const trigger = article.querySelector('[data-accordion-trigger]');
        const toggle = article.querySelector('.finding-toggle');
        if (trigger) trigger.setAttribute('aria-expanded', String(open));
        if (toggle) toggle.textContent = open ? 'Hide details' : 'Show details';
      }

      function activateFinding(id, { open = true, scroll = true } = {}) {
        details.forEach((el) => el.classList.remove('is-active'));
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.add('is-active');
        if (open) openFinding(el, true);
        if (scroll) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      rows.forEach((row) => {
        const go = () => {
          const id = row.dataset.target;
          activateFinding(id, { open: true, scroll: true });
        };
        row.addEventListener('click', (e) => {
          if (e.target.closest('a')) return;
          go();
        });
        row.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            go();
          }
        });
      });

      details.forEach((article) => {
        const trigger = article.querySelector('[data-accordion-trigger]');
        if (!trigger) return;
        const toggle = () => openFinding(article, !article.classList.contains('is-open'));
        trigger.addEventListener('click', (e) => {
          if (e.target.closest('.copy-btn')) return;
          toggle();
        });
        trigger.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggle();
          }
        });
      });

      const expandAll = document.getElementById('expand-all');
      const collapseAll = document.getElementById('collapse-all');
      if (expandAll) expandAll.addEventListener('click', () => details.forEach((el) => openFinding(el, true)));
      if (collapseAll) collapseAll.addEventListener('click', () => details.forEach((el) => openFinding(el, false)));

      document.querySelectorAll('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-copy');
          const node = document.getElementById(id);
          if (!node) return;
          const text = node.textContent || '';
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
              btn.textContent = 'Copied';
              setTimeout(() => { btn.textContent = 'Copy'; }, 1200);
            });
          }
        });
      });

      // Animate distribution bars after paint
      requestAnimationFrame(() => {
        document.querySelectorAll('.bar-fill[data-pct]').forEach((el) => {
          el.style.width = (el.getAttribute('data-pct') || '0') + '%';
        });
      });

      if (backTop) {
        const onScroll = () => {
          backTop.classList.toggle('show', window.scrollY > 500);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        onScroll();
      }

      apply();

      function triggerBlobDownload(blob, filename) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
      }

      function downloadHref(href, filename, mime) {
        setStatus('Preparing ' + filename + '…');
        return fetch(href, { cache: 'no-store' }).then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.blob();
        }).then(function (blob) {
          const typed = mime ? new Blob([blob], { type: mime }) : blob;
          triggerBlobDownload(typed, filename);
          setStatus('Downloaded ' + filename);
        }).catch(function () {
          const a = document.createElement('a');
          a.href = href;
          a.download = filename;
          a.target = '_blank';
          a.rel = 'noopener';
          document.body.appendChild(a);
          a.click();
          a.remove();
          setStatus('Opened ' + filename + ' (save from the browser if needed)');
        });
      }

      const mdSrc = document.getElementById('md-source');
      function markdownFromPage() {
        let md = '';
        try { md = JSON.parse(mdSrc && mdSrc.textContent || '""'); }
        catch (e) { md = (mdSrc && mdSrc.textContent) || ''; }
        return typeof md === 'string' ? md : String(md || '');
      }

      const mdInline = document.getElementById('dl-md-inline');
      if (mdInline) {
        mdInline.addEventListener('click', function () {
          const md = markdownFromPage();
          triggerBlobDownload(new Blob([md], { type: 'text/markdown;charset=utf-8' }), 'vulnsight_report.md');
          setStatus('Downloaded vulnsight_report.md');
        });
      }

      const mdFile = document.getElementById('dl-md-file');
      if (mdFile) {
        mdFile.addEventListener('click', function () {
          const href = mdFile.getAttribute('data-href') || 'vulnsight_report.md';
          downloadHref(href, 'vulnsight_report.md', 'text/markdown;charset=utf-8').catch(function () {
            const md = markdownFromPage();
            triggerBlobDownload(new Blob([md], { type: 'text/markdown;charset=utf-8' }), 'vulnsight_report.md');
            setStatus('Downloaded vulnsight_report.md (embedded)');
          });
        });
      }

      const pdfBtn = document.getElementById('dl-pdf');
      if (pdfBtn && !pdfBtn.disabled) {
        pdfBtn.addEventListener('click', function () {
          const href = pdfBtn.getAttribute('data-href') || 'vulnsight_report.pdf';
          downloadHref(href, 'vulnsight_report.pdf', 'application/pdf');
        });
      }

      const jsonBtn = document.getElementById('dl-json');
      if (jsonBtn) {
        jsonBtn.addEventListener('click', function () {
          const href = jsonBtn.getAttribute('data-href') || 'normalized_findings.json';
          downloadHref(href, 'normalized_findings.json', 'application/json');
        });
      }

      if (location.hash) {
        const id = location.hash.slice(1);
        if (id) activateFinding(id, { open: true, scroll: true });
      }
    })();
  </script>
</body>
</html>
